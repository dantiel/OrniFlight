!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title= title
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Outfit:wght@300..600&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}/assets/css/style.css"}

  %body
    .hero-bg
    .hero-overlay

    %nav
      %a.home-link{href: "#", onclick: "majesticScroll(); return false;", title: "OrniFlight"}
        %img{src: "#{asset_prefix}/assets/images/of_icon_128.png", alt: "OrniFlight"}
      %a{href: "#manifest"} Manifest
      %a{href: "#ondas"}= nav_ondas
      %a{href: "#features"}= nav_features
      %a{href: "#hardware"}= nav_hardware
      .lang-switch
        %a{href: lang_href_en, class: lang_class_en} EN
        %a{href: lang_href_de, class: lang_class_de} DE

    #header
      .hero-content
        .hero-logo
          %picture
            %source{srcset: "#{asset_prefix}/assets/images/cf_logo_white.svg", media: "(prefers-color-scheme: light)"}
            %img.logo-svg{src: "#{asset_prefix}/assets/images/cf_logo_black.svg", alt: "OrniFlight"}
        .headline
          %p.greeting= hero_greeting
          %p.version= hero_version

    %main
      %section#manifest
        %h2= manifest_title
        %p.lead!= manifest_lead
        %p!= manifest_body
        .highlight
          %code= manifest_highlight

      %section#ondas
        %h2= ondas_title
        %p.lead!= ondas_lead
        %p!= ondas_body
        .highlight
          %code= ondas_highlight
        %p.doc-link
          %a{href: "#{asset_prefix}/wiki/ondas.html"}= ondas_wiki_link

      %section#features
        %h2= features_title
        %dl.grid
          %dt= feat_profiles_title
          %dd= feat_profiles_desc
          %dt= feat_frequency_title
          %dd= feat_frequency_desc
          %dt= feat_gralhaazul_title
          %dd= feat_gralhaazul_desc
          %dt= feat_ondas_title
          %dd= feat_ondas_desc
          %dt= feat_msp_title
          %dd= feat_msp_desc
          %dt= feat_glide_title
          %dd= feat_glide_desc

      %section#hardware
        %h2= hw_title
        %p.lead= hw_lead
        %table.specs
          %tr
            %td= hw_targets_label
            %td= hw_targets_val
          %tr
            %td= hw_servos_label
            %td= hw_servos_val
          %tr
            %td= hw_rx_label
            %td= hw_rx_val
          %tr
            %td= hw_flash_label
            %td.value= hw_flash_val
          %tr
            %td= hw_ram_label
            %td.value= hw_ram_val
        %p.doc-link
          %a{href: "#{asset_prefix}/tutorials/"}= hw_start_link

      %section.build
        %h2= build_title
        %pre
          %code= build_line
        %p.compatible= build_compatible

    %footer
      %p!= footer_resources
      %p= footer_hermetic
      %p.credit= footer_credit

    %button.scroll-top{onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label" => "Scroll to top"}

    :javascript
      const hero = document.querySelector('.hero-content');
      const overlay = document.querySelector('.hero-overlay');
      const nav = document.querySelector('nav');
      const scrollBtn = document.querySelector('.scroll-top');

      function majesticScroll() {
        const start = window.scrollY;
        const duration = 1500;
        const startTime = performance.now();

        function step(now) {
          const elapsed = now - startTime;
          const t = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - t, 4);
          window.scrollTo(0, start * (1 - eased));
          if (t < 1) requestAnimationFrame(step);
        }

        requestAnimationFrame(step);
      }

      function tick() {
        const scroll = window.scrollY;
        const vh = window.innerHeight;
        const t = Math.min(scroll / vh, 1);

        hero.style.setProperty('--scroll', t.toFixed(3));
        hero.style.opacity = 1 - t * 0.7;
        hero.style.transform = `translateY(${t * 40}px)`;

        overlay.style.opacity = Math.min(t * 0.9, 0.9);

        nav.classList.toggle('scrolled', scroll > 40);
        scrollBtn.classList.toggle('visible', scroll > vh * 0.6);

        requestAnimationFrame(tick);
      }

      requestAnimationFrame(tick);