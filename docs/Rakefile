# encoding: utf-8
require "rake/clean"
require "json"
require "yaml"
require "haml"
require "kramdown"

LANGS = %w[en de ca es fr gl hr id it ja ko lv pt ru sv zh_CN]
SUBFOLDERS = %w[en de].flat_map { |l| ["#{l}", "#{l}/wiki", "#{l}/docs", "#{l}/tutorials"] }

CLOBBER.include(
  "index.html",
  *LANGS.map { |d| "#{d}/index.html" },
  *LANGS.flat_map { |l| ["#{l}/wiki/index.html", "#{l}/docs/index.html", "#{l}/tutorials/index.html"] },
  "assets/css/style.css"
)

# ── Landing Page: HAML + JSON i18n ────────────────────────────

def build_landing(lang)
  vars = JSON.parse(File.read("_lang/#{lang}.json", encoding: "UTF-8"))
  vars["asset_prefix"] = lang == "en" ? "." : ".."
  vars["footer_resources"] = vars["footer_resources"]
    .gsub('href="en/', %(href="#{vars["asset_prefix"]}/#{lang}/))
    .gsub('>Wiki</a>', ">#{vars['nav_wiki']}</a>")
    .gsub('>Tutorials</a>', ">#{vars['nav_tutorials']}</a>")
  vars["all_langs"] = ALL_LANGS_DATA
  vars["current_lang"] = lang
  template = File.read("index.haml", encoding: "UTF-8")
  engine = Haml::Template.new { template }
  output = engine.render(Object.new, vars)

  out_path = lang == "en" ? "index.html" : "#{lang}/index.html"
  File.write(out_path, output, encoding: "UTF-8")
  puts "  Built #{out_path} (#{lang.upcase})"
end

desc "Build landing pages (#{LANGS.map(&:upcase).join(' + ')})"
task :haml do
  LANGS.each { |lang| build_landing(lang) }
end

# ── Sass ──────────────────────────────────────────────────────

desc "Build Sass to CSS"
task :sass do
  sh "bundle exec sass assets/css/style.sass assets/css/style.css"
end

# ── Markdown Pages (Wiki, Docs, Tutorials) ────────────────────

HAML_LAYOUT = <<~'LAYOUT'
!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title= "#{page_title} — OrniFlight"
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Outfit:wght@300..600&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}/assets/css/style.css"}
  - body_cls = defined?(body_class) && body_class ? body_class : "subpage"
  %body{:class => body_cls}
    .hero-bg
    %nav
      %a.home-link{href: "#{asset_prefix}/", title: "OrniFlight"}
        %img.nav-logo{src: "#{asset_prefix}/assets/images/cf_logo_bird_black.svg", alt: "OrniFlight"}
      %a{href: "#{asset_prefix}/#manifest"}= nav_manifest
      %a{href: "#{asset_prefix}/#{lang}/wiki/"}= nav_wiki
      %a{href: "#{asset_prefix}/#{lang}/docs/"}= nav_docs
      %a{href: "#{asset_prefix}/#{lang}/wiki/servo_efficiency.html"}= nav_servos
      %a{href: "#{asset_prefix}/#{lang}/tutorials/"}= nav_tutorials
    .subpage-hero
      %picture.subpage-bird
        %source{srcset: "#{asset_prefix}/assets/images/cf_logo_white.svg", media: "(prefers-color-scheme: light)"}
        %img{src: "#{asset_prefix}/assets/images/cf_logo_black.svg", alt: ""}
      - if defined?(section_label) && section_label
        %p.subpage-label= section_label
      %h1= page_title
    %main.content-page
      %article
        != content_html
    %footer
      %p
        %a{href: "https://github.com/dantiel/OrniFlight"} GitHub
        ◇
        %a{href: "#{asset_prefix}/#{lang}/wiki/"}= nav_wiki
        ◇
        %a{href: "#{asset_prefix}/#{lang}/tutorials/"}= nav_tutorials
      %p.lang-footer
        - all_langs.each_with_index do |l, i|
          - if l[:code] == lang
            %strong= l[:name]
          - else
            - href = l[:code] == "en" ? "#{asset_prefix}/" : "#{asset_prefix}/#{l[:code]}/"
            %a{href: href}= l[:name]
          - unless i == all_langs.size - 1
            &nbsp;◇&nbsp;
      %p Hermetic Firmware ◇ STM32F4 ◇ GPL v3
      %p.credit OrniFlight — Flapping-wing flight, redefined.
    %button.scroll-top{onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label" => "Scroll to top"}
    :javascript
      const btn = document.querySelector('.scroll-top');
      addEventListener('scroll', () => btn.classList.toggle('visible', scrollY > window.innerHeight * 0.6));
LAYOUT

def asset_prefix_for(out_path)
  depth = out_path.count('/')
  depth == 0 ? '.' : ('../' * depth).sub(/\/$/, '')
end

LANG_NAMES = {
  "en" => "English", "de" => "Deutsch", "ca" => "Català",
  "es" => "Español", "fr" => "Français", "gl" => "Galego",
  "hr" => "Hrvatski", "id" => "Bahasa Indonesia", "it" => "Italiano",
  "ja" => "日本語", "ko" => "한국어", "lv" => "Latviešu",
  "pt" => "Português", "ru" => "Русский", "sv" => "Svenska",
  "zh_CN" => "中文"
}.freeze

ALL_LANGS_DATA = LANGS.map { |l| {code: l, name: LANG_NAMES[l] || l} }.freeze

def build_markdown_page(md_path, out_path, lang, page_title, body_class: nil, section_label: nil)
  md_content = File.read(md_path, encoding: "UTF-8")
  content_html = Kramdown::Document.new(md_content).to_html

  asset_prefix = asset_prefix_for(out_path)
  dir = "ltr"
  section_label ||= File.dirname(out_path).split('/').last.capitalize rescue nil
  vars = JSON.parse(File.read("_lang/#{lang}.json", encoding: "UTF-8"))

  engine = Haml::Template.new { HAML_LAYOUT }
  output = engine.render(Object.new, {
    lang: lang,
    dir: dir,
    page_title: page_title,
    asset_prefix: asset_prefix,
    content_html: content_html,
    all_langs: ALL_LANGS_DATA,
    body_class: body_class,
    section_label: section_label,
    nav_manifest: vars["nav_manifest"],
    nav_wiki: vars["nav_wiki"],
    nav_docs: vars["nav_docs"],
    nav_servos: vars["nav_servos"],
    nav_tutorials: vars["nav_tutorials"]
  })

  File.write(out_path, output, encoding: "UTF-8")
  puts "  Built #{out_path} (#{lang.upcase} #{page_title})"
end

def build_section_index(lang, section, title_key)
  out_path = "#{lang}/#{section}/index.html"
  asset_prefix = asset_prefix_for(out_path)
  vars = JSON.parse(File.read("_lang/#{lang}.json", encoding: "UTF-8"))
  page_title = vars[title_key] || section.capitalize
  intro_key = "#{section}_intro"
  intro_text = vars[intro_key]

  en_dir = "en/#{section}"
  md_dir = "#{lang}/#{section}"

  # Merge local + English articles; local entries take priority, EN-only link to en/
  seen = {}
  entries = []
  [md_dir, en_dir].each do |dir|
    next unless Dir.exist?(dir)
    Dir["#{dir}/*.md"].each do |f|
      name = File.basename(f, ".md")
      next if seen[name]
      seen[name] = true
      first_line = File.readlines(f, encoding: "UTF-8").first.to_s.strip.sub(/^#\s*/, "")
      title = first_line.empty? ? name.tr("_", " ").capitalize : first_line
      link = (dir == md_dir) ? "./#{name}.html" : "#{asset_prefix}/en/#{section}/#{name}.html"
      entries << { file: name, title: title, link: link }
    end
  end
  entries.sort_by! { |e| e[:title].downcase }

  links_html = entries.map { |e|
    %(<li><a href="#{e[:link]}">#{e[:title]}</a></li>)
  }.join("\n")

  intro_html = intro_text ? %(<p class="lead section-intro">#{intro_text}</p>) : ""

  index_html = "#{intro_html}\n<ul class=\"page-index\">\n#{links_html}\n</ul>"

  engine = Haml::Template.new { HAML_LAYOUT }
  output = engine.render(Object.new, {
    lang: lang,
    dir: "ltr",
    page_title: page_title,
    asset_prefix: asset_prefix,
    content_html: index_html,
    all_langs: ALL_LANGS_DATA,
    section_label: nil,
    nav_manifest: vars["nav_manifest"],
    nav_wiki: vars["nav_wiki"],
    nav_docs: vars["nav_docs"],
    nav_servos: vars["nav_servos"],
    nav_tutorials: vars["nav_tutorials"]
  })

  File.write(out_path, output, encoding: "UTF-8")
  puts "  Built #{out_path} (#{lang.upcase} #{section} index)"
end

desc "Build all Markdown content pages"
task :pages do
  LANGS.each do |lang|
    %w[wiki docs tutorials].each do |section|
      md_dir = "#{lang}/#{section}"
      if Dir.exist?(md_dir)
        Dir["#{md_dir}/*.md"].each do |md_path|
          name = File.basename(md_path, ".md")
          out_path = "#{md_dir}/#{name}.html"
          title = File.readlines(md_path, encoding: "UTF-8").first.to_s.strip.sub(/^#\s*/, "")
          title = name.tr("_", " ").capitalize if title.empty?
          extra = name == "servo_efficiency" ? {body_class: "subpage servo-page"} : {}
          build_markdown_page(md_path, out_path, lang, title, **extra)
        end
      end
      build_section_index(lang, section, "nav_#{section}")
    end
  end
end

# ── Servo Efficiency Page ─────────────────────────────────────

def build_servo_page(lang)
  data = YAML.safe_load(File.read("_data/servos.yml", encoding: "UTF-8"))
  servos = data["servos"]

  rows = servos.map do |s|
    eff = s["eff_per_euro_scale"]
    eff_str = eff.is_a?(Numeric) ? ("%.2f" % eff) : eff.to_s
    fp = s["flight_performance"]
    untested_label = lang == "de" ? "Ungetestet" : "Untested"
    if fp.is_a?(Hash)
      rating = fp["rating"].to_i
      note   = fp["note"].to_s
      flight_attr = %( data-flight-rating="#{rating}")
      flight_cell = note
      row_extra = ""
      flight_class = "flight"
    else
      rating = 0
      flight_attr = ""
      flight_cell = untested_label
      row_extra = %( class="untested")
      flight_class = "flight untested-cell"
    end
    notes = s["notes"] || ""

    price_raw = s["price"]
    if price_raw.is_a?(Numeric)
      price_str = ("%.2f" % price_raw)
      price_attr = %( data-price-eur="#{price_str}")
      price_cell = "€#{price_str}"
    else
      price_attr = ""
      price_cell = price_raw.to_s
    end

    torque_raw = s["torque"]
    torque_s = torque_raw.is_a?(Numeric) ? ("%.2f" % torque_raw) : torque_raw.to_s
    speed_raw = s["speed"]
    speed_s = speed_raw.is_a?(Numeric) ? ("%.2f" % speed_raw) : speed_raw.to_s
    weight_raw = s["weight"]
    weight_s = weight_raw.is_a?(Numeric) ? ("%.1f" % weight_raw) : weight_raw.to_s
    eff_raw_val = s["efficiency"]
    eff_raw = eff_raw_val.is_a?(Numeric) ? ("%.2f" % eff_raw_val) : eff_raw_val.to_s
    voltage_s = ("%.1f" % s["voltage"])

    brand = s["brand"].to_s
    %(      <tr#{row_extra} data-voltage="#{voltage_s}" data-brand="#{brand}">
        <td>#{brand} #{s["model"]}</td>
        <td class="num">#{voltage_s}</td>
        <td class="num">#{weight_s}</td>
        <td class="num">#{torque_s}</td>
        <td class="num">#{speed_s}</td>
        <td class="num">#{eff_raw}</td>
        <td class="num"#{price_attr}>#{price_cell}</td>
        <td class="num strong">#{eff_str}</td>
        <td class="#{flight_class}"#{flight_attr}>#{flight_cell}</td>
        <td class="notes">#{notes}</td>
      </tr>)
  end.join("\n")

  table_html = <<~TABLE
    <div class="voltage-range-bar">
      <span class="vr-label">Voltage</span>
      <div class="vr-track">
        <input type="range" class="vr-min" min="4.8" max="14.0" step="0.1" value="4.8">
        <input type="range" class="vr-max" min="4.8" max="14.0" step="0.1" value="14.0">
      </div>
      <span class="vr-readout">4.8V – 14.0V</span>
    </div>
    <div class="brand-filter-bar">
      <span class="br-label">Brand</span>
      <select class="brand-select">
        <option value="*" selected>All</option>
      </select>
    </div>
    <div class="table-wrap">
    <table class="servo-table">
      <thead>
        <tr>
          <th>Servo</th>
          <th class="num">V</th>
          <th class="num">Weight g</th>
          <th class="num">Torque kg/cm</th>
          <th class="num">Speed s/60°</th>
          <th class="num">Efficiency</th>
          <th class="num">Price</th>
          <th class="num">Eff/<span class="currency-symbol">€</span></th>
          <th>Flight Performance</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
    #{rows}
      </tbody>
    </table>
    </div>
    <script src="../../assets/js/servo-table.js"></script>
  TABLE

  intro = case lang
  when "en"
    <<~EN
      # Servo Efficiency

      A curated selection of servos tested and ranked for ornithopter use.
      **Efficiency** = Torque / (Weight × Speed). **Eff/<span class="currency-symbol">€</span>** = Efficiency per <span class="currency-inline"><select class="currency-select inline-currency">
        <option value="EUR">Euro</option><option value="USD">Dollar</option><option value="GBP">Pound</option>
        <option value="CHF">Franc</option><option value="JPY">Yen</option><option value="BRL">Real</option>
      </select></span>, scaled by ∛torque for fairness across sizes.
      Higher is better. Click column headers to sort — <strong>Shift+click</strong> for multi-column sort. Drag the voltage slider to narrow. Submit additions per PR to `_data/servos.yml`.
    EN
  when "de"
    <<~DE
      # Servo-Effizienz

      Eine kuratierte Auswahl getesteter Servos für Ornithopter.
      **Effizienz** = Drehmoment / (Gewicht × Geschwindigkeit). **Eff/<span class="currency-symbol">€</span>** = Effizienz pro <span class="currency-inline"><select class="currency-select inline-currency">
        <option value="EUR">Euro</option><option value="USD">Dollar</option><option value="GBP">Pound</option>
        <option value="CHF">Franc</option><option value="JPY">Yen</option><option value="BRL">Real</option>
      </select></span>, skaliert mit ∛Drehmoment.
      Höher ist besser. Spaltenköpfe anklicken zum Sortieren — <strong>Shift+Klick</strong> für mehrspaltige Sortierung. Spannungs-Slider zum Eingrenzen. Ergänzungen per PR an `_data/servos.yml`.
    DE
  else
    <<~EN
      # Servo Efficiency

      A curated selection of servos tested and ranked for ornithopter use.
      **Efficiency** = Torque / (Weight × Speed). **Eff/<span class="currency-symbol">€</span>** = Efficiency per <span class="currency-inline"><select class="currency-select inline-currency">
        <option value="EUR">Euro</option><option value="USD">Dollar</option><option value="GBP">Pound</option>
        <option value="CHF">Franc</option><option value="JPY">Yen</option><option value="BRL">Real</option>
      </select></span>, scaled by ∛torque for fairness across sizes.
      Higher is better. Click column headers to sort — <strong>Shift+click</strong> for multi-column sort. Drag the voltage slider to narrow. Submit additions per PR to `_data/servos.yml`.
    EN
  end

  md_content = intro + "\n\n" + table_html + "\n"
  md_path = "#{lang}/wiki/servo_efficiency.md"
  File.write(md_path, md_content, encoding: "UTF-8")
  puts "  Generated #{md_path}"
end

desc "Generate servo efficiency pages from _data/servos.yml"
task :servos do
  LANGS.each { |lang| build_servo_page(lang) }
end

# ── Aggregate ─────────────────────────────────────────────────

desc "Build all"
task build: [:haml, :sass, :servos, :pages]

desc "Clean and build"
task rebuild: [:clobber, :build]

# ── Watch ─────────────────────────────────────────────────────

desc "Watch for changes and rebuild automatically"
task :watch do
  puts "◇  Watching site/ for changes... (Ctrl+C to stop)"
  puts "   Monitoring: *.haml, *.sass, _lang/*.json, **/*.md"
  puts

  Rake::Task[:build].invoke

  watched = Dir["index.haml", "assets/css/style.sass", "_lang/*.json"] +
            Dir["en/**/*.md", "de/**/*.md"]
  mtimes = watched.to_h { |f| [f, File.mtime(f)] }

  loop do
    sleep 0.5
    changed = watched.select { |f| File.exist?(f) && File.mtime(f) != mtimes[f] }
    next if changed.empty?

    changed.each { |f| mtimes[f] = File.mtime(f) }
    puts "\n◇ Changed: #{changed.map { |f| f.sub(%r{^\./}, "") }.join(', ')}"

    begin
      run_sass = changed.any? { |f| f.end_with?(".sass") }
      run_haml = changed.any? { |f| f.end_with?(".haml", ".json") }
      run_pages = changed.any? { |f| f.end_with?(".md") }

      Rake::Task[:sass].reenable; Rake::Task[:sass].invoke if run_sass
      Rake::Task[:haml].reenable; Rake::Task[:haml].invoke if run_haml
      Rake::Task[:pages].reenable; Rake::Task[:pages].invoke if run_pages
      puts "◇ Rebuilt at #{Time.now.strftime('%H:%M:%S')}"
    rescue => e
      puts "◇ Error: #{e.message}"
    end
  end
end

desc "Start a local HTTP server (http://localhost:8000)"
task :server do
  require "webrick"

  root = File.expand_path(__dir__)
  server = WEBrick::HTTPServer.new(
    Port: 8000,
    DocumentRoot: root,
    BindAddress: "0.0.0.0"
  )

  trap("INT") { server.shutdown }
  trap("TERM") { server.shutdown }

  puts "◇  OrniFlight site server"
  puts "   ◆ http://localhost:8000/"
  puts "   ◆ http://localhost:8000/en/"
  puts "   Ctrl+C to stop"
  puts

  server.start
end

task default: :build