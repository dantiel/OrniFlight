# encoding: utf-8
require "rake/clean"
require "json"
require "yaml"
require "haml"
require "kramdown"

LANGS = %w[en de]
SUBFOLDERS = LANGS.flat_map { |l| ["#{l}", "#{l}/wiki", "#{l}/docs", "#{l}/tutorials"] }

CLOBBER.include(
  "index.html",
  *LANGS.map { |d| "#{d}/index.html" },
  *LANGS.flat_map { |l| ["#{l}/wiki/index.html", "#{l}/docs/index.html", "#{l}/tutorials/index.html"] },
  "assets/css/style.css"
)

# ── Landing Page: HAML + JSON i18n ────────────────────────────

def build_landing(lang)
  vars = JSON.parse(File.read("_lang/#{lang}.json", encoding: "UTF-8"))
  template = File.read("index.haml", encoding: "UTF-8")
  engine = Haml::Template.new { template }
  output = engine.render(Object.new, vars)

  out_path = lang == "en" ? "index.html" : "#{lang}/index.html"
  File.write(out_path, output, encoding: "UTF-8")
  puts "  Built #{out_path} (#{lang.upcase})"
end

desc "Build landing pages (#{LANGS.map(&:upcase).join(' + ')})"
task :haml do
  LANGS.each { |lang| build_landing(lang) }
end

# ── Sass ──────────────────────────────────────────────────────

desc "Build Sass to CSS"
task :sass do
  sh "bundle exec sass assets/css/style.sass assets/css/style.css"
end

# ── Markdown Pages (Wiki, Docs, Tutorials) ────────────────────

HAML_LAYOUT = <<~'LAYOUT'
!!!
%html{lang: lang, dir: dir}
  %head
    %meta{charset: "utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %title= "#{page_title} — OrniFlight"
    %link{rel: "preconnect", href: "https://fonts.googleapis.com"}
    %link{rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: true}
    %link{rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Outfit:wght@300..600&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap"}
    %link{rel: "stylesheet", href: "#{asset_prefix}/assets/css/style.css"}
  %body.subpage
    .hero-bg
    %nav
      %a.home-link{href: "#{asset_prefix}/", title: "OrniFlight"}
        %img{src: "#{asset_prefix}/assets/images/of_icon_128.png", alt: "OrniFlight"}
      %a{href: "#{asset_prefix}/#manifest"} Manifest
      %a{href: "#{asset_prefix}/en/wiki/"} Wiki
      %a{href: "#{asset_prefix}/en/docs/"} Docs
      %a{href: "#{asset_prefix}/en/wiki/servo_efficiency.html"} Servos
      %a{href: "#{asset_prefix}/en/tutorials/"} Tutorials
      .lang-switch
        - langs.each do |l|
          %a{href: l == lang ? "." : lang_href.call(l), class: l == lang ? "active" : ""}= l.upcase
    .subpage-hero
      %img.subpage-bird{src: "#{asset_prefix}/assets/images/of_icon_128.png", alt: ""}
      %h1= page_title
    %main.content-page
      %article
        != content_html
    %footer
      %p
        %a{href: "https://github.com/dantiel/OrniFlight"} GitHub
        ◇
        %a{href: "#{asset_prefix}/en/wiki/"} Wiki
        ◇
        %a{href: "#{asset_prefix}/en/tutorials/"} Tutorials
      %p Hermetic Firmware ◇ STM32F4 ◇ GPL v3
      %p.credit OrniFlight — Flapping-wing flight, redefined.
    %button.scroll-top{onclick: "window.scrollTo({top:0,behavior:'smooth'})", "aria-label" => "Scroll to top"}
    :javascript
      const btn = document.querySelector('.scroll-top');
      addEventListener('scroll', () => btn.classList.toggle('visible', scrollY > window.innerHeight * 0.6));
LAYOUT

def asset_prefix_for(out_path)
  depth = out_path.count('/')
  depth == 0 ? '.' : ('../' * depth).sub(/\/$/, '')
end

def lang_href(target_lang)
  target_lang == "en" ? "../" : "../#{target_lang}/"
end

def build_markdown_page(md_path, out_path, lang, page_title)
  md_content = File.read(md_path, encoding: "UTF-8")
  content_html = Kramdown::Document.new(md_content).to_html

  asset_prefix = asset_prefix_for(out_path)
  dir = "ltr"

  engine = Haml::Template.new { HAML_LAYOUT }
  output = engine.render(Object.new, {
    lang: lang,
    dir: dir,
    page_title: page_title,
    asset_prefix: asset_prefix,
    content_html: content_html,
    langs: LANGS,
    lang_href: method(:lang_href)
  })

  File.write(out_path, output, encoding: "UTF-8")
  puts "  Built #{out_path} (#{lang.upcase} #{page_title})"
end

def build_section_index(lang, section, title_key)
  out_path = "#{lang}/#{section}/index.html"
  asset_prefix = asset_prefix_for(out_path)
  vars = JSON.parse(File.read("_lang/#{lang}.json", encoding: "UTF-8"))
  page_title = vars[title_key] || section.capitalize
  intro_key = "#{section}_intro"
  intro_text = vars[intro_key]

  md_dir = "#{lang}/#{section}"
  entries = Dir["#{md_dir}/*.md"].map do |f|
    name = File.basename(f, ".md")
    first_line = File.readlines(f, encoding: "UTF-8").first.to_s.strip.sub(/^#\s*/, "")
    { file: name, title: first_line.empty? ? name.tr("_", " ").capitalize : first_line }
  end.sort_by { |e| e[:title].downcase }

  links_html = entries.map { |e|
    %(<li><a href="./#{e[:file]}.html">#{e[:title]}</a></li>)
  }.join("\n")

  intro_html = intro_text ? %(<p class="lead section-intro">#{intro_text}</p>) : ""

  index_html = "<h1>#{page_title}</h1>\n#{intro_html}\n<ul class=\"page-index\">\n#{links_html}\n</ul>"

  engine = Haml::Template.new { HAML_LAYOUT }
  output = engine.render(Object.new, {
    lang: lang,
    dir: "ltr",
    page_title: page_title,
    asset_prefix: asset_prefix,
    content_html: index_html,
    langs: LANGS,
    lang_href: method(:lang_href)
  })

  File.write(out_path, output, encoding: "UTF-8")
  puts "  Built #{out_path} (#{lang.upcase} #{section} index)"
end

desc "Build all Markdown content pages"
task :pages do
  LANGS.each do |lang|
    %w[wiki docs tutorials].each do |section|
      md_dir = "#{lang}/#{section}"
      next unless Dir.exist?(md_dir)
      Dir["#{md_dir}/*.md"].each do |md_path|
        name = File.basename(md_path, ".md")
        out_path = "#{md_dir}/#{name}.html"
        title = File.readlines(md_path, encoding: "UTF-8").first.to_s.strip.sub(/^#\s*/, "")
        title = name.tr("_", " ").capitalize if title.empty?
        build_markdown_page(md_path, out_path, lang, title)
      end
      build_section_index(lang, section, "nav_#{section}")
    end
  end
end

# ── Servo Efficiency Page ─────────────────────────────────────

def build_servo_page(lang)
  data = YAML.safe_load(File.read("_data/servos.yml", encoding: "UTF-8"))
  servos = data["servos"]

  rows = servos.map do |s|
    eff = s["eff_per_euro_scale"]
    eff_str = eff.is_a?(Numeric) ? ("%.2f" % eff) : eff.to_s
    flight = s["flight_tested"] || ""
    notes = s["notes"] || ""

    price_raw = s["price"]
    if price_raw.is_a?(Numeric)
      price_str = ("%.2f" % price_raw)
      price_attr = %( data-price-eur="#{price_str}")
      price_cell = "€#{price_str}"
    else
      price_attr = ""
      price_cell = price_raw.to_s
    end

    torque_s = ("%.2f" % s["torque"])
    speed_s = ("%.2f" % s["speed"])
    weight_s = ("%.1f" % s["weight"])
    eff_raw = ("%.2f" % s["efficiency"])
    voltage_s = ("%.1f" % s["voltage"])

    %(      <tr>
        <td>#{s["brand"]} #{s["model"]}</td>
        <td class="num">#{voltage_s}</td>
        <td class="num">#{weight_s}</td>
        <td class="num">#{torque_s}</td>
        <td class="num">#{speed_s}</td>
        <td class="num">#{eff_raw}</td>
        <td class="num"#{price_attr}>#{price_cell}</td>
        <td class="num strong">#{eff_str}</td>
        <td class="flight">#{flight}</td>
        <td class="notes">#{notes}</td>
      </tr>)
  end.join("\n")

  currency_bar = <<~BAR
    <div class="currency-bar">
      <label for="currency-select">Currency</label>
      <select id="currency-select" class="currency-select">
        <option value="EUR">EUR €</option>
        <option value="USD">USD $</option>
        <option value="GBP">GBP £</option>
        <option value="CHF">CHF</option>
        <option value="JPY">JPY ¥</option>
        <option value="BRL">BRL R$</option>
      </select>
    </div>
  BAR

  table_html = <<~TABLE
    #{currency_bar}
    <table class="servo-table">
      <thead>
        <tr>
          <th>Servo</th>
          <th class="num">V</th>
          <th class="num">Weight g</th>
          <th class="num">Torque kg/cm</th>
          <th class="num">Speed s/60°</th>
          <th class="num">Efficiency</th>
          <th class="num">Price</th>
          <th class="num">Eff/€ ★</th>
          <th>Flight Test</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>
    #{rows}
      </tbody>
    </table>
    <script src="../../assets/js/servo-table.js"></script>
  TABLE

  intro = case lang
  when "en"
    <<~EN
      # Servo Efficiency

      A curated selection of servos tested and ranked for ornithopter use.
      **Efficiency** = Torque / (Weight × Speed). **Eff/€ ★** = Efficiency per Euro, scaled by &cuberoot;torque for fairness across sizes.
      Higher is better. Flight-tested entries marked with real-world results.

      Click column headers to sort. Submit additions via PR to `_data/servos.yml`.
    EN
  when "de"
    <<~DE
      # Servo-Effizienz

      Eine kuratierte Auswahl getesteter Servos für Ornithopter.
      **Effizienz** = Drehmoment / (Gewicht × Geschwindigkeit). **Eff/€ ★** = Effizienz pro Euro, skaliert mit &cuberoot;Drehmoment.
      Höher ist besser. Fluggetestete Einträge mit Praxisergebnissen.

      Spaltenköpfe anklicken zum Sortieren. Ergänzungen per PR an `_data/servos.yml`.
    DE
  end

  md_content = intro + "\n\n" + table_html + "\n"
  md_path = "#{lang}/wiki/servo_efficiency.md"
  File.write(md_path, md_content, encoding: "UTF-8")
  puts "  Generated #{md_path}"
end

desc "Generate servo efficiency pages from _data/servos.yml"
task :servos do
  LANGS.each { |lang| build_servo_page(lang) }
end

# ── Aggregate ─────────────────────────────────────────────────

desc "Build all"
task build: [:haml, :sass, :servos, :pages]

desc "Clean and build"
task rebuild: [:clobber, :build]

# ── Watch ─────────────────────────────────────────────────────

desc "Watch for changes and rebuild automatically"
task :watch do
  puts "◇  Watching site/ for changes... (Ctrl+C to stop)"
  puts "   Monitoring: *.haml, *.sass, _lang/*.json, **/*.md"
  puts

  Rake::Task[:build].invoke

  watched = Dir["index.haml", "assets/css/style.sass", "_lang/*.json"] +
            Dir["en/**/*.md", "de/**/*.md"]
  mtimes = watched.to_h { |f| [f, File.mtime(f)] }

  loop do
    sleep 0.5
    changed = watched.select { |f| File.exist?(f) && File.mtime(f) != mtimes[f] }
    next if changed.empty?

    changed.each { |f| mtimes[f] = File.mtime(f) }
    puts "\n◇ Changed: #{changed.map { |f| f.sub(%r{^\./}, "") }.join(', ')}"

    begin
      run_sass = changed.any? { |f| f.end_with?(".sass") }
      run_haml = changed.any? { |f| f.end_with?(".haml", ".json") }
      run_pages = changed.any? { |f| f.end_with?(".md") }

      Rake::Task[:sass].reenable; Rake::Task[:sass].invoke if run_sass
      Rake::Task[:haml].reenable; Rake::Task[:haml].invoke if run_haml
      Rake::Task[:pages].reenable; Rake::Task[:pages].invoke if run_pages
      puts "◇ Rebuilt at #{Time.now.strftime('%H:%M:%S')}"
    rescue => e
      puts "◇ Error: #{e.message}"
    end
  end
end

desc "Start a local HTTP server (http://localhost:8000)"
task :server do
  require "webrick"

  root = File.expand_path(__dir__)
  server = WEBrick::HTTPServer.new(
    Port: 8000,
    DocumentRoot: root,
    BindAddress: "0.0.0.0"
  )

  trap("INT") { server.shutdown }
  trap("TERM") { server.shutdown }

  puts "◇  OrniFlight site server"
  puts "   ◆ http://localhost:8000/"
  puts "   ◆ http://localhost:8000/en/"
  puts "   Ctrl+C to stop"
  puts

  server.start
end

task default: :build