voConfig);\n\ntypedef struct servoProfile_s {\n    servoParam_t servoConf[MAX_SUPPORTED_SERVOS];\n} servoProfile_t;\n\nextern int16_t servo[MAX_SUPPORTED_SERVOS];\n\nbool isMixerUsingServos(void);\nvoid writeServos(void);\nvoid servoMixerLoadMix(int index);\nvoid loadCustomServoMixer(void);\nint servoDirection(int servoIndex, int fromChannel);\nvoid servoConfigureOutput(void);\nvoid servosInit(void);\nvoid servosFilterInit(void);\nvoid servoMixer(void);\n// tricopter specific\nvoid servosTricopterInit(void);\nvoid servosTricopterMixer(void);\nbool servosTricopterIsEnabledServoUnarmed(void);\n", :execution_time=>0.009}, :args=>{:path=>"src/main/flight/servos.h"}, :execution_time=>0.009}, {:id=>"call_01_CMPm48Y23cP4Up4iryff3275", :name=>"run_command", :result=>{:ok=>true, :exit_status=>0, :result=>"Command output: 844:    { &quot;flap_speed_modificator&quot;,     VAR_UINT16 | PROFILE_RATE_VALUE, .config.minmaxUnsigned = { PWM_PULSE_MIN, PWM_PULSE_MAX }, PG_CONTROL_RATE_PROFILES, offsetof(controlRateConfig_t, flap_speed_modificator) },\n1426:    { &quot;flap_base_frequency&quot;,   VAR_UINT8 | MASTER_VALUE, .config.minmaxUnsigned = { 0, 255 }, PG_SERVO_CONFIG, offsetof(servoConfig_t, flap_base_frequency) },\n1427:    { &quot;flap_base_amplitude&quot;,   VAR_INT8 | MASTER_VALUE, .config.minmax = { -128, 127 }, PG_SERVO_CONFIG, offsetof(servoConfig_t, flap_base_amplitude) },\n1428:    { &quot;ornithopter_glide_deg&quot;, VAR_INT8 | MASTER_VALUE, .config.minmax = { -128, 127 }, PG_SERVO_CONFIG, offsetof(servoConfig_t, ornithopter_glide_deg) },\n1429:    { &quot;ondas_gain&quot;,            VAR_INT8 | MASTER_VALUE, .config.minmax = { -100, 100 }, PG_SERVO_CONFIG, offsetof(servoConfig_t, ondas_gain) },\n1430:    { &quot;ondas_gain2&quot;,           VAR_INT8 | MASTER_VALUE, .config.minmax = { -100, 100 }, PG_SERVO_CONFIG, offsetof(servoConfig_t, ondas_gain2) },\n1431:    { &quot;ondas_gain3&quot;,           VAR_INT8 | MASTER_VALUE, .config.minmax = { -100, 100 }, PG_SERVO_CO