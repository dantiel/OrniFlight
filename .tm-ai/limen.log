0\n    @prev_error = 0.0\n  end\n\n  def update(setpoint, measurement, dt, ondas_attenuation, ondas_deriv)\n    error = setpoint - measurement\n\n    # ONDAS-gated error (matching pid.c line ~1525)\n    gated_error = error * (1.0 + (ondas_attenuation - 0.5) * 0.5 * 0.1)\n\n    # P term\n    p_term = @kp * gated_error\n\n    # I term (with anti-windup)\n    @integral += @ki * gated_error * dt\n    @integral = @integral.clamp(-@i_limit, @i_limit)\n    i_term = @integral\n\n    # D term with ONDAS derivative gating\n    deriv_gate = 1.0 + (ondas_deriv - 0.5) * 0.5 * 0.1\n    derivative = (gated_error - @prev_error) / dt\n    d_term = @kd * derivative * deriv_gate\n\n    @prev_error = gated_error\n\n    p_term + i_term + d_term\n  end\n=======\nclass PIDController\n  attr_accessor :kp, :ki, :kd, :i_limit\n\n  def initialize(kp: 0.5, ki: 0.1, kd: 0.02, i_limit: 10.0)\n    @kp = kp\n    @ki = ki\n    @kd = kd\n    @i_limit = i_limit\n    @integral = 0.0\n    @prev_error = 0.0\n  end\n\n  def update(setpoint, measurement, dt, ondas_attenuation, ondas_deriv)\n    error = setpoint - measurement\n\n    # ONDAS-gated error (matching pid.c: errorRate *= 1.0 + (ondasAttenuation - 0.5) * ondas_gain * 0.1)\n    gated_error = error * (1.0 + (ondas_attenuation - 0.5) * 0.5 * 0.1)\n\n    # P term\n    p_term = @kp * gated_error\n\n    # I term (with anti-windup)\n    @integral += @ki * gated_error * dt\n    @integral = @integral.clamp(-@i_limit, @i_limit) if @integral.finite?\n    i_term = @integral.finite? ? @integral : 0.0\n\n    # D term with ONDAS derivative gating\n    deriv_gate = 1.0 + (ondas_deriv - 0.5) * 0.5 * 0.1\n    derivative = (gated_error - @prev_error) / dt\n    d_term = @kd * derivative * deriv_gate\n\n    @prev_error = gated_error.finite? ? gated_error : 0.0\n\n    result = p_term + i_term + d_term\n    result.finite? ? result.clamp(-20.0, 20.0) : 0.0\n  end\n>>>>>>> REPLACE\n\n<<<<<<< SEARCH\n:start_line:160\n-------\ndef mode_flight(duration: 10.0, f_down_p: 30, f_up_p: 30,\n                disturbance_at: nil, disturbance_magnitude: 0.5)\n  f_down = ferocity_param_to_float(f_down_p)\n  f_up   = ferocity_param_to_float(f_up_p)\n\n  wing      = WingState.new\n  airframe  = Airframe.new\n  pid       = PIDController.new(kp: 0.5, ki: 0.1, kd: 0.02)\n\n  throttle  = 1500.0  # mid-throttle (µs)\n  setpoint  = 0.0     # target pitch rate = 0 (hover)\n\n  dist_time = disturbance_at || (duration * 0.3)\n\n  steps = (duration / DT).to_i\n  t = 0.0\n\n  puts CSV.generate { |csv| csv << %w[time theta sin_theta shaped_wave ondas_att ondas_deriv\n                                       pitch_angle pitch_rate pid_output flap_amplitude] }\n\n  steps.times do\n    # Wing ODE step\n    wing.step(throttle)\n    sin_th  = Math.sin(wing.theta)\n    shaped  = apply_ferocity(sin_th, f_down, f_up)\n    ondas   = -shaped.abs + 0.5\n    cos_th  = Math.cos(wing.theta)\n    ondas_d = cos_th * cos_th - sin_th * sin_th\n\n    # Airframe aerodynamics from flapping\n    # Disturbance: simulate a gust\n    gust = 0.0\n    if disturbance_at && t >= dist_time && t < dist_time + 0.2\n      gust = disturbance_magnitude\n    end\n\n    # PID: try to keep pitch_rate at setpoint\n    measurement = airframe.pitch_rate + gust\n    control = pid.update(setpoint, measurement, DT, ondas, ondas_d)\n\n    # Apply control as torque (servos bias the wings)\n    airframe.step(shaped, control)\n\n    # Amplitude (matching getFlappingAmplitude)\n    amp = 0.0\n    if throttle > GLIDE_THRESHOLD\n      amp = (throttle - GLIDE_THRESHOLD) * 0.04 * 30.0 * 0.1\n    end\n\n    puts CSV.generate { |csv| csv << [t.round(4), wing.theta, sin_th, shaped.round(4),\n                                       ondas.round(4), ondas_d.round(4),\n                                       airframe.pitch_angle.round(6), airframe.pitch_rate.round(6),\n                                       control.round(6), amp.round(4)] }\n\n    t += DT\n  end\nend\n=======\ndef mode_flight(duration: 5.0, f_down_p: 30, f_up_p: 30,\n                disturbance_at: nil, disturbance_magnitude: 10.0)\n  f_down = ferocity_param_to_float(f_down_p)\n  f_up   = ferocity_param_to_float(f_up_p)\n\n  wing      = WingState.new\n  airframe  = Airframe.new\n  pid       = PIDController.new(kp: 0.8, ki: 0.2, kd: 0.03)\n\n  throttle  = 1500.0  # mid-throttle (µs)\n  setpoint  = 0.0     # target pitch rate = 0 (hover)\n\n  dist_time = disturbance_at || (duration * 0.4)\n\n  steps = (duration / DT).to_i\n  t = 0.0\n\n  puts CSV.generate { |csv| csv << %w[time theta sin_theta shaped_wave ondas_att ondas_deriv\n                                       pitch_rate pid_output] }\n\n  steps.times do\n    # Wing ODE step\n    wing.step(throttle)\n    sin_th  = Math.sin(wing.theta)\n    shaped  = apply_ferocity(sin_th, f_down, f_up)\n    ondas   = -shaped.abs + 0.5\n    cos_th  = Math.cos(wing.theta)\n    ondas_d = cos_th * cos_th - sin_th * sin_th\n\n    # Disturbance: simulate a sharp gust (deg/s of pitch rate)\n    gust = 0.0\n    if disturbance_at && t >= dist_time && t < dist_time + 0.15\n      gust = disturbance_magnitude\n    end\n\n    # PID: try to keep pitch_rate at setpoint\n    measurement = airframe.pitch_rate + gust\n    control = pid.update(setpoint, measurement, DT, ondas, ondas_d)\n\n    # Apply control as torque to counter disturbance\n    airframe.step(shaped, control)\n\n    puts CSV.generate { |csv| csv << [t.round(4), wing.theta.round(3), sin_th.round(3),\n                                       shaped.round(3), ondas.round(3), ondas_d.round(3),\n                                       airframe.pitch_rate.round(4), control.round(4)] }\n\n    t += DT\n  end\nend\n>>>>>>> REPLACE\n"}, :execution_time=>6.186}, {:content=>""}, {:id=>"call_00_3yh5vgKbZJhnkkf4GMXa7106", :name=>"run_command", :result=>{:ok=>true, :exit_status=>0, :result=>"Command output: time,theta,sin_theta,shaped_wave,ondas_att,ondas_deriv,pitch_rate,pid_output\n0.0,0.0,0.0,0.0,0.5,1.0,0.0,0.0\n0.001,0.042,0.042,0.08,0.42,0.9