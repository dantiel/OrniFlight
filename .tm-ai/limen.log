*start* of the stroke where ferocity actually amplifies."}, {:id=>"call_00_T5LfoJbW6EaGU7a8zuG39647", :name=>"patch_file", :result=>{:ok=>true, :execution_time=>5.441}, :args=>{:path=>"sim_ferocity.rb", :diff=>"<<<<<<< SEARCH\n:start_line:158\n-------\nclass StrokeFF\n  # Tracks pitch error over each half-stroke, computes ferocity bias for next stroke\n  attr_reader :f_down_bias, :f_up_bias\n\n  def initialize\n    @f_down_bias = 0.0\n    @f_up_bias   = 0.0\n    @prev_sin    = 0.0\n    @accum_error = 0.0\n    @accum_count = 0\n  end\n\n  # Call every timestep. Returns [f_down_effective, f_up_effective]\n  def update(sin_theta, pitch_error, base_f_down, base_f_up)\n    # Detect zero crossing\n    crossing = (@prev_sin * sin_theta <= 0) && (@prev_sin != sin_theta)\n\n    if crossing\n      # sin went through zero — stroke boundary\n      # Average pitch error over the half-stroke just completed\n      if @accum_count > 0\n        mean_err = @accum_error / @accum_count\n\n        if @prev_sin > 0  # just finished downstroke (sin was +, now 0 or -)\n          # Downstroke completed → bias NEXT upstroke\n          # pitch error > 0 (nose up) → more upstroke ferocity → nose-down thrust\n          @f_up_bias = K_FF * mean_err\n        else  # just finished upstroke\n          # Upstroke completed → bias NEXT downstroke\n          # pitch error < 0 (nose down) → more downstroke ferocity → nose-up thrust\n          @f_down_bias = -K_FF * mean_err\n        end\n      end\n\n      @accum_error = 0.0\n      @accum_count = 0\n    end\n\n    # Accumulate\n    @accum_error += pitch_error\n    @accum_count += 1\n    @prev_sin = sin_theta\n\n    # Effective ferocity: base + bias, clamped\n    fd = (base_f_down + @f_down_bias).clamp(F_MIN, F_MAX)\n    fu = (base_f_up   + @f_up_bias).clamp(F_MIN, F_MAX)\n    [fd, fu]\n  end\nend\n=======\nclass StrokeFF\n  # Tracks pitch error over each half-stroke, computes ferocity bias for next stroke\n  attr_reader :f_down_bias, :f_up_bias\n\n  def initialize\n    @f_down_bias = 0.0\n    @f_up_bias   = 0.0\n    @prev_sin    = nil\n    @accum_error = 0.0\n    @accum_count = 0\n  end\n\n  # Call every timestep. Returns [f_down_effective, f_up_effective]\n  def update(sin_theta, pitch_error, base_f_down, base_f_up)\n    # Detect zero crossing (skip first call)\n    crossing = @prev_sin && (@prev_sin * sin_theta <= 0) && (@prev_sin != sin_theta)\n\n    if crossing\n      # sin went through zero — stroke boundary\n      # Average pitch error over the half-stroke just completed\n      if @accum_count > 0\n        mean_err = @accum_error / @accum_count\n\n        if @prev_sin > 0  # just finished downstroke (sin was +, now 0 or -)\n          # Downstroke completed → bias NEXT upstroke\n          # pitch error > 0 (nose up) → more upstroke ferocity → nose-down thrust\n          @f_up_bias = K_FF * mean_err\n        else  # just finished upstroke\n          # Upstroke completed → bias NEXT downstroke\n          # pitch error < 0 (nose down) → more downstroke ferocity → nose-up thrust\n          @f_down_bias = -K_FF * mean_err\n        end\n      end\n\n      @accum_error = 0.0\n      @accum_count = 0\n    end\n\n    # Accumulate\n    @accum_error += pitch_error\n    @accum_count += 1\n    @prev_sin = sin_theta\n\n    # Effective ferocity: base + bias, clamped\n    fd = (base_f_down + @f_down_bias).clamp(F_MIN, F_MAX)\n    fu = (base_f_up   + @f_up_bias).clamp(F_MIN, F_MAX)\n    [fd, fu]\n  end\nend\n>>>>>>> REPLACE\n\n<<<<<<< SEARCH\n:start_line:440\n-------\n  puts\n  puts \"═══ Velocity Amplification by Ferocity ═══\"\n  puts \"At θ=30° (sinθ=0.5), ω=30 rad/s:\"\n  [1.0, 2.0, 4.0, 8.0].each do |f|\n    wing = Wing.new(f_down: f, f_up: f, theta: 30.0 * Math::PI / 180.0, omega: 30.0)\n    wing.step(1.0)\n    wv = wing.deriv_gain * wing.cos_theta * wing.omega\n    puts \"  F=\#{f.round(1)}: shaped=\#{wing.shaped.round(4)}, velocity_gain=\#{wing.deriv_gain.round(3)}, wing_vel=\#{wv.round(2)} rad/s, thrust∝\#{((wv*wv*TH